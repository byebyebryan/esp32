[Unit]
Description=349-status desk display daemon
Documentation=file:%h/code/esp32/projects/349-status/README.md
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/code/esp32/projects/349-status/host
ExecStart=/usr/bin/uv run --frozen 349d
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
